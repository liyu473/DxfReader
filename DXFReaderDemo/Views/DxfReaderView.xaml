<UserControl
    x:Class="DXFReaderDemo.Views.DxfReaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxf="clr-namespace:DXFReaderCore.Controls;assembly=DXFReaderCore"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:lyu="http://schemas.lyuwpfhelper.com/winfx/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:viewmodel="clr-namespace:DXFReaderDemo.ViewModels"
    Padding="59,0"
    d:DataContext="{d:DesignInstance Type=viewmodel:DxfReaderViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <Grid lyu:GridHelper.RowDefinitions="Auto,*">
        <lyu:DrawersHost Grid.RowSpan="2">
            <lyu:Drawer
                x:Name="SettingsDrawer"
                Width="520"
                Header="显示设置"
                Position="Right">
                <ui:ScrollViewerEx
                    Padding="16"
                    ui:AutoHideScrollBars="True"
                    VerticalScrollBarVisibility="Auto">
                    <ikw:SimpleStackPanel Spacing="12">
                        <Border
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:FontIcon
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Icon="{x:Static ui:SegoeFluentIcons.Color}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="选中颜色" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="选中图元时的高亮颜色" />
                                </StackPanel>

                                <ikw:SquarePicker
                                    Grid.Column="2"
                                    MinWidth="180"
                                    MinHeight="180"
                                    SelectedColor="{Binding SelectedPrimitiveColor, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Border
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:FontIcon
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Icon="{x:Static ui:SegoeFluentIcons.Photo}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="画布底色" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="默认黑色，也可以按习惯调整" />
                                </StackPanel>

                                <ikw:SquarePicker
                                    Grid.Column="2"
                                    MinWidth="180"
                                    MinHeight="180"
                                    SelectedColor="{Binding CanvasBackgroundColor, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <ui:SettingsCard Description="支持鼠标滚轮缩放和中键拖动画布，点一下回到自适应视图。" Header="视图操作">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Zoom}" />
                            </ui:SettingsCard.HeaderIcon>
                            <Button Click="ResetView_Click" Content="重置视图" />
                        </ui:SettingsCard>
                    </ikw:SimpleStackPanel>
                </ui:ScrollViewerEx>
            </lyu:Drawer>
        </lyu:DrawersHost>

        <Grid Grid.Row="0" lyu:GridHelper.ColumnDefinitions="Auto,*">
            <lyu:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{Binding ImportDxfCommand}" Content="导入 DXF 文件" />
                <Button Click="OpenSettings_Click" Content="显示设置" />
            </lyu:SimpleStackPanel>
            <TextBlock
                Grid.Column="1"
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding FileInfoText}"
                TextWrapping="Wrap" />
        </Grid>

        <Grid
            Grid.Row="1"
            Margin="0,16,0,0"
            lyu:GridHelper.ColumnDefinitions="3*,320">
            <dxf:DxfViewer
                x:Name="PreviewViewer"
                Margin="0,0,12,0"
                AutoFit="True"
                Background="{Binding CanvasBackgroundBrush}"
                Drawing="{Binding DxfDrawing}"
                SelectedPrimitive="{Binding SelectedPrimitive, Mode=TwoWay}"
                SelectedPrimitiveBrush="{Binding SelectedPrimitiveBrush}" />

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid lyu:GridHelper.RowDefinitions="Auto,Auto,*">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="图元列表" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,8,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding SelectedPrimitiveInfoText}"
                        TextWrapping="Wrap" />

                    <ListBox
                        Grid.Row="2"
                        Background="Transparent"
                        ItemsSource="{Binding Primitives}"
                        SelectedValue="{Binding SelectedPrimitive, Mode=TwoWay}"
                        SelectedValuePath="Primitive">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Detail}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
